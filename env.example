# Text LLM provider: antigravity (Google OAuth via agy CLI) or gemini (Vertex AI)
LLM_PROVIDER=gemini
ANTIGRAVITY_COMMAND=
ANTIGRAVITY_MODEL=Gemini 3.1 Pro (Low)
ANTIGRAVITY_TIMEOUT_MS=120000

# Vertex AI and Gemini Live. Authenticate once with:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west4
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# macOS Call Copilot (system audio -> Gemini Live)
SYSTEM_AUDIO_COMMAND=
FFMPEG_COMMAND=ffmpeg
CALL_COPILOT_SILENCE_MS=800
CALL_COPILOT_MAX_UTTERANCE_MS=20000
CALL_COPILOT_VAD_FLOOR=0.006
